# HEALORA Configuration
PROJECT_NAME="HEALORA - Smart Hospital Communication Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=True

# Security & Authentication
# Generate a secret with: openssl rand -hex 32
SECRET_KEY="healora-super-secure-production-ready-secret-key-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS settings (comma-separated origins)
BACKEND_CORS_ORIGINS=["*"]

# Database configuration
# PostgreSQL format: postgresql+psycopg2://healora_user:healora_pass@localhost:5432/healora_db
# SQLite format (default fallback for development): sqlite:///./healora.db
DATABASE_URL="sqlite:///./healora.db"

# Firebase Cloud Messaging (FCM)
# Optional: Set path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=""

# External AI Provider (Optional)
# If left empty, HEALORA utilizes the built-in modular rule-based agent engine
OPENAI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"

# Hospital Workflow Settings
DEFAULT_APPOINTMENT_DURATION_MINUTES=30
AUTO_ASSIGN_QUERIES=True
UPLOAD_DIR="./uploads"
